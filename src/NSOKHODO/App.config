<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5.2" />
  </startup>
  <runtime>
    <!-- Treo hang tram account trong 1 tien trinh: moi account co thread nhan/gui + thread tick,
         va moi goi tin sinh byte[] tam. Workstation GC gom rac tren chinh cac thread do va lam
         dung ca tien trinh; Server GC dung heap + thread gom rieng cho moi CPU -> throughput cao
         hon va it khung hinh dung hon. Doi lai ton RAM hon mot chut. -->
    <gcServer enabled="true" />
  </runtime>
</configuration>
